{
  "name": "totalkontrol",
  "private": true,
  "version": "0.1.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:winmidi": "tauri dev --features windows-midi-services",
    "demo:osc": "node tools/osc-led-demo.mjs",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "build:winmidi": "tauri build --config src-tauri/tauri.windows-midi.conf.json --features windows-midi-services"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
