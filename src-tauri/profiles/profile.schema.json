{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PoUpA/totalKONTROL/profile.schema.json",
  "title": "Profil totalKONTROL",
  "description": "Mapping of the Korg padKONTROL's controls to MIDI messages, organized in banks.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "banks"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "description": "Version of the profile format.",
      "const": 1
    },
    "name": {
      "description": "Name of the profile as shown.",
      "type": "string",
      "minLength": 1
    },
    "ports": {
      "description": "MIDI ports to use. Each value is part of the port name, ignoring case.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input": { "type": "string", "description": "padKONTROL input port.", "default": "padKONTROL" },
        "output": { "type": "string", "description": "Output port to the DAW.", "default": "totalKONTROL" }
      }
    },
    "startBank": {
      "description": "Index (from 0) of the bank active at startup.",
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "display": {
      "description": "What the 3-character display shows besides the active bank.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knobs": {
          "description": "Shows the value sent when a knob turns.",
          "type": "boolean",
          "default": true
        },
        "encoder": {
          "description": "Shows the value sent when the encoder turns.",
          "type": "boolean",
          "default": true
        },
        "pads": {
          "description": "What a pad hit shows. none: nothing. note: the note played. velocity: the velocity.",
          "enum": ["none", "note", "velocity"],
          "default": "none"
        },
        "duration": {
          "description": "Milliseconds a value stays on the display before the bank comes back.",
          "type": "integer",
          "minimum": 200,
          "maximum": 10000,
          "default": 1000
        }
      }
    },
    "velocity": {
      "description": "Shaping of the pads' hit velocity (notes, $velocity of OSC actions, display). Fixed velocities do not change.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "curve": {
          "description": "soft: light hits come out louder. linear: as is. hard: hit hard to go high.",
          "enum": ["soft", "linear", "hard"],
          "default": "linear"
        },
        "min": {
          "description": "Velocity sent for the softest hit.",
          "type": "integer",
          "minimum": 1,
          "maximum": 127,
          "default": 1
        },
        "max": {
          "description": "Velocity sent for the hardest hit.",
          "type": "integer",
          "minimum": 1,
          "maximum": 127,
          "default": 127
        }
      }
    },
    "repeat": {
      "description": "Settings of roll (note repeated while the pad is held) and flam (grace note just before the hit), turned on by the roll and flam actions.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bpm": {
          "description": "Roll tempo when the DAW sends no MIDI clock to the feedback input.",
          "type": "number",
          "minimum": 20,
          "maximum": 300,
          "default": 120
        },
        "roll": {
          "description": "Division of a whole note: 16 for sixteenth notes, 12 for eighth-note triplets.",
          "enum": [4, 6, 8, 12, 16, 24, 32],
          "default": 16
        },
        "flam": {
          "description": "Milliseconds between the grace note and the hit.",
          "type": "integer",
          "minimum": 5,
          "maximum": 200,
          "default": 30
        },
        "xySpeed": {
          "description": "true: while roll or flam is on, the X axis of the XY pad sets the division or the gap instead of its action.",
          "type": "boolean",
          "default": true
        }
      }
    },
    "banks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bank" }
    }
  },
  "$defs": {
    "channel": { "description": "MIDI channel, from 1 to 16.", "type": "integer", "minimum": 1, "maximum": 16 },
    "midiValue": { "type": "integer", "minimum": 0, "maximum": 127 },
    "velocity": { "description": "Fixed velocity, from 1 to 127.", "type": "integer", "minimum": 1, "maximum": 127 },
    "mode": {
      "description": "momentary: on while the control is held down. toggle: flips on each press.",
      "enum": ["momentary", "toggle"],
      "default": "momentary"
    },
    "led": {
      "description": "LED behavior. none: off. press: lit while pressed. toggle: follows the toggle state. follow: driven by the same message sent back by the DAW. Default: press in momentary mode, toggle in toggle mode.",
      "enum": ["none", "press", "toggle", "follow"]
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "display": {
          "description": "Display text for this bank, 3 characters at most. Default: the start of the name.",
          "type": "string",
          "pattern": "^[ -~]{0,3}$"
        },
        "pads": {
          "description": "Pads 1 to 16, numbered from left to right and top to bottom.",
          "type": "object",
          "propertyNames": { "pattern": "^([1-9]|1[0-6])$" },
          "additionalProperties": { "$ref": "#/$defs/padAction" }
        },
        "buttons": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/buttonId" },
          "additionalProperties": { "$ref": "#/$defs/buttonAction" }
        },
        "knobs": {
          "description": "Knobs 1 and 2.",
          "type": "object",
          "propertyNames": { "enum": ["1", "2"] },
          "additionalProperties": { "$ref": "#/$defs/knobAction" }
        },
        "xy": { "$ref": "#/$defs/xyAction" },
        "xyTouch": {
          "description": "Action when a finger lands on the XY pad (press) then leaves it (release). Like a button, without an LED.",
          "$ref": "#/$defs/buttonAction"
        },
        "encoder": { "$ref": "#/$defs/encoderAction" }
      }
    },
    "buttonId": {
      "enum": [
        "scene",
        "message",
        "setting",
        "noteCc",
        "midiCh",
        "swType",
        "relVal",
        "velocity",
        "port",
        "fixedVelocity",
        "progChange",
        "x",
        "y",
        "knob1Assign",
        "knob2Assign",
        "pedal",
        "roll",
        "flam",
        "hold"
      ]
    },
    "noteAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "channel", "note"],
      "properties": {
        "type": { "const": "note" },
        "channel": { "$ref": "#/$defs/channel" },
        "note": { "$ref": "#/$defs/midiValue" },
        "velocity": { "$ref": "#/$defs/velocity", "default": 127 },
        "mode": { "$ref": "#/$defs/mode" },
        "led": { "$ref": "#/$defs/led" }
      }
    },
    "padNoteAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "channel", "note"],
      "properties": {
        "type": { "const": "note" },
        "channel": { "$ref": "#/$defs/channel" },
        "note": { "$ref": "#/$defs/midiValue" },
        "velocity": {
          "description": "\"pad\": velocity of the pad hit. Otherwise, a fixed velocity.",
          "oneOf": [{ "const": "pad" }, { "$ref": "#/$defs/velocity" }],
          "default": "pad"
        },
        "mode": { "$ref": "#/$defs/mode" },
        "led": { "$ref": "#/$defs/led" }
      }
    },
    "ccButtonAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "channel", "cc"],
      "properties": {
        "type": { "const": "cc" },
        "channel": { "$ref": "#/$defs/channel" },
        "cc": { "$ref": "#/$defs/midiValue" },
        "onValue": { "$ref": "#/$defs/midiValue", "default": 127 },
        "offValue": { "$ref": "#/$defs/midiValue", "default": 0 },
        "mode": { "$ref": "#/$defs/mode" },
        "led": { "$ref": "#/$defs/led" }
      }
    },
    "programChangeAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "channel", "program"],
      "properties": {
        "type": { "const": "programChange" },
        "channel": { "$ref": "#/$defs/channel" },
        "program": { "$ref": "#/$defs/midiValue" },
        "led": { "$ref": "#/$defs/led" }
      }
    },
    "switchBankAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "bank"],
      "properties": {
        "type": { "const": "switchBank" },
        "bank": { "description": "Index (from 0) of the target bank.", "type": "integer", "minimum": 0 },
        "momentary": {
          "description": "true: goes back to the previous bank on release.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "keys": {
      "description": "Keyboard shortcut: names separated by +, for example ctrl+shift+s. Modifiers: ctrl, shift, alt (option), meta (win, cmd). Keys: a character, plus, minus, space, enter, tab, esc, backspace, delete, insert, home, end, pageup, pagedown, up, down, left, right, f1 to f20, num0 to num9, capslock, printscreen, pause, volumeup, volumedown, mute, playpause, next, previous.",
      "type": "string",
      "minLength": 1
    },
    "keyAction": {
      "description": "Types a keyboard shortcut into the app in front.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "keys"],
      "properties": {
        "type": { "const": "key" },
        "keys": { "$ref": "#/$defs/keys" },
        "hold": {
          "description": "true: the keys stay down while the control is held. false: a short tap on each press.",
          "type": "boolean",
          "default": false
        },
        "led": { "$ref": "#/$defs/led" }
      }
    },
    "rollAction": {
      "description": "Turns roll on or off: pads in momentary mode repeat their note while held.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "roll" } }
    },
    "flamAction": {
      "description": "Turns flam on or off: pads in momentary mode play a softer grace note just before the hit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "flam" } }
    },
    "padAction": {
      "oneOf": [
        { "$ref": "#/$defs/padNoteAction" },
        { "$ref": "#/$defs/ccButtonAction" },
        { "$ref": "#/$defs/programChangeAction" },
        { "$ref": "#/$defs/switchBankAction" },
        { "$ref": "#/$defs/oscButtonAction" },
        { "$ref": "#/$defs/keyAction" },
        { "$ref": "#/$defs/rollAction" },
        { "$ref": "#/$defs/flamAction" }
      ]
    },
    "buttonAction": {
      "oneOf": [
        { "$ref": "#/$defs/noteAction" },
        { "$ref": "#/$defs/ccButtonAction" },
        { "$ref": "#/$defs/programChangeAction" },
        { "$ref": "#/$defs/switchBankAction" },
        { "$ref": "#/$defs/oscButtonAction" },
        { "$ref": "#/$defs/keyAction" },
        { "$ref": "#/$defs/rollAction" },
        { "$ref": "#/$defs/flamAction" }
      ]
    },
    "oscAddress": {
      "description": "OSC address: starts with / and has no spaces.",
      "type": "string",
      "pattern": "^/\\S*$"
    },
    "oscValue": {
      "description": "OSC argument: integer, decimal, boolean or text. The text \"$velocity\" is replaced by the velocity of the hit (127 for a button).",
      "type": ["integer", "number", "boolean", "string"]
    },
    "oscButtonAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "address"],
      "properties": {
        "type": { "const": "osc" },
        "address": { "$ref": "#/$defs/oscAddress" },
        "args": {
          "description": "Arguments sent on press (or when the toggle turns on).",
          "type": "array",
          "items": { "$ref": "#/$defs/oscValue" }
        },
        "releaseArgs": {
          "description": "Arguments sent on release (or when the toggle turns off). Without this field, nothing is sent.",
          "type": "array",
          "items": { "$ref": "#/$defs/oscValue" }
        },
        "mode": { "$ref": "#/$defs/mode" },
        "led": { "$ref": "#/$defs/led" }
      }
    },
    "knobAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "channel", "cc"],
          "properties": {
            "type": { "const": "cc" },
            "channel": { "$ref": "#/$defs/channel" },
            "cc": { "$ref": "#/$defs/midiValue" },
            "min": { "$ref": "#/$defs/midiValue", "default": 0 },
            "max": { "$ref": "#/$defs/midiValue", "default": 127 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "address"],
          "properties": {
            "type": { "const": "osc" },
            "address": { "$ref": "#/$defs/oscAddress" },
            "min": {
              "description": "Value sent with the knob all the way to the left.",
              "type": "number",
              "default": 0
            },
            "max": {
              "description": "Value sent with the knob all the way to the right.",
              "type": "number",
              "default": 127
            },
            "float": {
              "description": "true: sends a decimal. Otherwise, a rounded integer.",
              "type": "boolean",
              "default": false
            }
          }
        }
      ]
    },
    "xyAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "channel", "ccX", "ccY"],
          "properties": {
            "type": { "const": "xy" },
            "channel": { "$ref": "#/$defs/channel" },
            "ccX": { "$ref": "#/$defs/midiValue" },
            "ccY": { "$ref": "#/$defs/midiValue" }
          }
        },
        {
          "description": "Sends x and y (0 to 127) as two integers.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "address"],
          "properties": {
            "type": { "const": "osc" },
            "address": { "$ref": "#/$defs/oscAddress" }
          }
        }
      ]
    },
    "encoding": {
      "description": "relative: sends a step (CC: 1 per step to the right and 127 per step to the left; OSC: +1 / -1). absolute: sends a value from 0 to 127 kept by the app.",
      "enum": ["relative", "absolute"],
      "default": "relative"
    },
    "encoderAction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "channel", "cc"],
          "properties": {
            "type": { "const": "cc" },
            "channel": { "$ref": "#/$defs/channel" },
            "cc": { "$ref": "#/$defs/midiValue" },
            "encoding": { "$ref": "#/$defs/encoding" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "address"],
          "properties": {
            "type": { "const": "osc" },
            "address": { "$ref": "#/$defs/oscAddress" },
            "encoding": { "$ref": "#/$defs/encoding" }
          }
        },
        {
          "description": "Types a keyboard shortcut at each step.",
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "left", "right"],
          "properties": {
            "type": { "const": "key" },
            "left": { "$ref": "#/$defs/keys", "description": "Shortcut typed at each step to the left." },
            "right": { "$ref": "#/$defs/keys", "description": "Shortcut typed at each step to the right." }
          }
        }
      ]
    }
  }
}
