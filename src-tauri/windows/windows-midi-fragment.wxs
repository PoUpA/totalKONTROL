<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX fragment for the installer built with the windows-midi-services feature
  (tauri.windows-midi.conf.json).

  The bundled Windows.Devices.Midi2.dll comes with a "go live" license that
  forbids installing it on Windows versions older than Windows 11 25H2
  (build 26200). The MSI properties VersionNT and WindowsBuild stop at
  Windows 8.1, so the build number is read from the registry, and a launch
  condition refuses the install below 26200. Uninstalling stays possible.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="TOTALKONTROL_WINBUILD">
      <RegistrySearch Id="TotalKontrolWinBuild" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" />
    </Property>
    <Condition Message="Cette version de totalKONTROL nécessite Windows 11 25H2 (build 26200) ou plus récent. Sur ce Windows, installez la version standard de totalKONTROL, qui passe par loopMIDI.">
      <![CDATA[Installed OR (TOTALKONTROL_WINBUILD >= 26200)]]>
    </Condition>
    <!-- Empty group: referenced from componentGroupRefs so that WiX links this fragment. -->
    <ComponentGroup Id="WindowsMidiLaunchCondition" />
  </Fragment>
</Wix>
